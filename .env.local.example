NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Melewati semua RLS — JANGAN beri prefix NEXT_PUBLIC_,
# jangan commit nilai aslinya. Ambil dari Supabase Dashboard >
# Project Settings > API > service_role. Dipakai lookup invoice/track
# publik yang terkunci access_token setelah RLS ditutup.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_PRESET=
# Server-only untuk signed upload Cloudinary (logo/banner toko). Bila
# keduanya terisi, upload memakai tanda tangan server dan preset unsigned
# tidak lagi dipakai. Ambil dari Cloudinary Console > Settings > API Keys.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Fase 3: QRIS dinamis ShopeePay (server-only, JANGAN commit nilainya) ---
# Kunci enkripsi platform untuk kredensial ShopeePay per toko (AES-256-GCM).
# WAJIB 32 byte: base64 44 karakter ATAU hex 64 karakter. Generate sekali,
# mis. `openssl rand -base64 32`, lalu isi nilai yang SAMA di Vercel
# (Production) dan .env.local. Bila kunci ini berubah, kredensial toko
# yang sudah tersimpan tidak bisa lagi dibaca (harus diisi ulang).
SHOPEEPAY_ENCRYPTION_KEY=
# Host API ShopeePay (default = sandbox). Samakan dengan dokumen ShopeePay
# Partner saat kredensial sandbox tiba; production = https://api.shopeepay.co.id
# (konfirmasi host persisnya di dokumen Partner sebelum pilot production).
SHOPEEPAY_BASE_URL=https://api.sandbox.shopeepay.co.id
# Path inquiry status QR (cadangan bila webhook telat). BELUM TERKONFIRMASI
# dari dokumen Partner — samakan sebelum dipakai live; kegagalan inquiry
# tidak menggagalkan checkout (status lokal yang dipakai).
SHOPEEPAY_QR_STATUS_PATH=/v1.0/qr/qr-mpm-query

# --- Fase 5: Domain sendiri + subdomain (server-only kecuali yang NEXT_PUBLIC_) ---
# Token API Vercel untuk mendaftarkan domain custom ke project secara
# otomatis (Dashboard → Domain). JANGAN commit nilainya. Buat di Vercel
# Dashboard → Settings → Tokens (scope: project jualin saja bila bisa).
# Bila kosong, domain tetap bisa dipakai — pemilik menambahkannya manual
# di Vercel Dashboard → Settings → Domains.
VERCEL_API_TOKEN=
# ID project Vercel "jualin" (bukan secret; sudah ada fallback di kode).
VERCEL_PROJECT_ID=prj_N19xmVADtzl3Dvcnvoup2DW4L4s0
# Domain platform untuk subdomain toko {slug}.domain (cuan.is-a.web.id).
# Bila kosong, subdomain tidak aktif dan halaman Domain menjelaskan
# apa yang dibutuhkan. Isi lalu redeploy.
NEXT_PUBLIC_PLATFORM_DOMAIN=cuan.is-a.web.id
# URL kanonis situs platform (dipakai sitemap/robots + canonical bila
# halaman dibuka lewat path /{slug}).
NEXT_PUBLIC_SITE_URL=https://cuan.is-a.web.id

# --- Pembayaran langganan platform (NEXT_PUBLIC_, tampil di halaman Langganan) ---
# Rekening + QRIS platform untuk pembayaran paket Silver/Gold secara manual
# (pembeli paket transfer/QRIS ke sini, lalu admin verifikasi). Dibaca
# src/lib/subscription-payment-config.ts. Nilai sudah diset di Vercel
# (Production); contoh ini hanya dokumentasi — JANGAN commit nilai aslinya.
NEXT_PUBLIC_PLATFORM_BANK_NAME=
NEXT_PUBLIC_PLATFORM_BANK_ACCOUNT=
NEXT_PUBLIC_PLATFORM_BANK_HOLDER=
# URL gambar QRIS platform (saat ini gambar QRIS GoPay TOKO IBEL di
# public/qris-platform.jpg — isi URL publiknya bila dipakai dari CDN).
NEXT_PUBLIC_PLATFORM_QRIS_URL=

# --- Cron transisi status langganan (server-only, JANGAN commit nilainya) ---
# Secret untuk route GET /api/cron/subscription-transitions (cron harian
# 07:00 WIB, lihat vercel.json). Vercel Cron mengirim header
# `Authorization: Bearer <CRON_SECRET>` OTOMATIS bila env ini diset di
# project — jadi JANGAN tulis secret di URL/vercel.json. Generate sekali,
# mis. `openssl rand -base64 32`, isi nilai yang SAMA di Vercel
# (Production) dan .env.local. Tanpa env ini, cron mengembalikan 401
# dan tombol "Jalankan transisi sekarang" di admin tetap jalan (pakai
# sesi admin, bukan secret ini).
CRON_SECRET=

# --- Notifikasi email + WhatsApp (server-only, JANGAN commit nilainya) ---
# Email — Resend (paket gratis permanen: 3.000 email/bulan, maks 100/hari,
# tanpa kartu kredit, tanpa overage; pengiriman berhenti saat cap tercapai).
# Daftar gratis di https://resend.com/signup, lalu API Keys > Create API Key.
# Tanpa domain terverifikasi, Resend HANYA bisa mengirim ke email pemilik
# akun Resend — jadi untuk tes awal set RESEND_FROM ke
# `CUAN <onboarding@resend.dev>`; untuk kirim ke semua pembeli/penjual,
# verifikasi dulu cuan.is-a.web.id di Resend (Domains > Add Domain,
# pasang DNS yang diminta), lalu set RESEND_FROM ke
# `CUAN <noreply@cuan.is-a.web.id>`. Tanpa RESEND_API_KEY, email dilewati
# diam-diam dan notifikasi in-app tetap jalan.
RESEND_API_KEY=
RESEND_FROM=CUAN <noreply@cuan.is-a.web.id>
# WhatsApp — Meta Cloud API (resmi). Akses API gratis, tapi tiap pesan
# template utility proaktif DITAGIH Rp356,65/pesan (rate card 1 Okt 2026,
# Indonesia); gratis hanya 1.000 service reply/bulan (balasan chat yang
# dimulai pelanggan — BUKAN notifikasi ini). JANGAN pakai Fonnte/Wablas
# sebagai default (berbayar bulanan + tidak resmi, risiko nomor diblokir).
# Setup: Meta Developers > buat aplikasi WhatsApp > tambah nomor WABA >
# salin Phone Number ID + token akses (System User, permanen) > buat +
# minta persetujuan template (nama default: cuan_order_created,
# cuan_order_paid, cuan_payment_proof, cuan_order_shipped,
# cuan_order_completed, cuan_order_cancelled, cuan_subscription_reminder,
# cuan_subscription_update, cuan_subscription_verified,
# cuan_subscription_rejected, cuan_staff_added, cuan_test).
# Tanpa kedua env ini, WhatsApp dilewati diam-diam dan in-app + email
# tetap jalan. Nama template bisa diubah per jenis lewat env
# WHATSAPP_TEMPLATE_<JENIS> (mis. WHATSAPP_TEMPLATE_ORDER_PAID).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
